<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/morrow_splash_icon_vector">
    <target android:name="orb">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.3" android:valueTo="1" android:valueType="floatType" android:duration="650" android:startOffset="0" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.3" android:valueTo="1" android:valueType="floatType" android:duration="650" android:startOffset="0" android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="ringBack">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="rotation" android:valueFrom="-214" android:valueTo="-24" android:valueType="floatType" android:duration="800" android:startOffset="0" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="ringFront">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="rotation" android:valueFrom="-214" android:valueTo="-24" android:valueType="floatType" android:duration="800" android:startOffset="0" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="sparkle">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="350" android:startOffset="500" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="350" android:startOffset="500" android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>